meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{rocket_url}}:{{rocket_port}}/auth/login
  body: json
  auth: inherit
}

body:json {
  {
    "email": "dernoncourt.tom@gmail.com",
    "password": "test"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("token", res.body.token);
    bru.setVar("refresh_token", res.body.refresh_token);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
