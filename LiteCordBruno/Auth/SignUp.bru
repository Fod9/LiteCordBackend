meta {
  name: SignUp
  type: http
  seq: 1
}

post {
  url: {{rocket_url}}:{{rocket_port}}/auth/signup
  body: json
  auth: inherit
}

body:json {
  {
    "email": "dernoncourt.tom+3@gmail.com",
    "name": "FoD97",
    "password": "test"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("token", res.body.token);
    bru.setVar("refresh_token", res.body.refresh_token);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
